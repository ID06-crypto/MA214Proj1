library(dplyr)
library(readr)
library(tidyr)
library(ggplot2)
df <- read_csv("team_stats_2003_2023.csv")
# Defining response and predictors
response <- "win_loss_perc"
predictors <- setdiff(
names(df),
response
)
# Splitting into Training and Testing Data
set.seed(123)
n <- nrow(df)
train_index <- sample(
1:n,
size = 0.80 * n
)
train_df <- df[train_index, ]
test_df <- df[-train_index, ]
# Fit the full model
full_formula <- as.formula(
paste(
response,
"~",
paste(predictors, collapse = " + ")
)
)
full_model <- lm(
full_formula,
data = train_df
)
results <- data.frame(
dropped_predictor = "None (Full Model)",
adjusted_r_squared = summary(full_model)$adj.r.squared,
AIC = AIC(full_model)
)
